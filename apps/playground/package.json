{
  "name": "@kyc-lens/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Development playground, theme studio and local sample upload receiver for kyc-lens-react.",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "vite --open",
    "dev:no-open": "vite",
    "build": "node scripts/sync-assets.mjs --full && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/sync-assets.mjs --full && playwright test"
  },
  "dependencies": {
    "kyc-lens-react": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
