{
  "name": "kyc-lens-react",
  "version": "0.1.0",
  "description": "React automatic document capture, guided selfies and local face comparison with bundled models and no inference service.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "react",
    "kyc",
    "camera",
    "selfie",
    "document-capture",
    "face-landmarks",
    "mediapipe",
    "typescript",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "assets",
    "scripts/copy-assets.mjs",
    "demo/server.ts",
    "README.md",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "kyc-lens-copy-assets": "./scripts/copy-assets.mjs"
  },
  "scripts": {
    "dev": "vite --open",
    "dev:no-open": "vite",
    "setup": "node scripts/prepare-assets.mjs",
    "build": "tsdown && node scripts/build-extra.mjs",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/copy-assets.mjs demo/public/kyc-assets && playwright test",
    "check:matching-reference": "node tests/fixtures/verify-matching-reference.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run setup && npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "onnxruntime-web": "1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philippschwarz1992/kyc-lens.git"
  },
  "homepage": "https://github.com/philippschwarz1992/kyc-lens#readme",
  "bugs": {
    "url": "https://github.com/philippschwarz1992/kyc-lens/issues"
  }
}
