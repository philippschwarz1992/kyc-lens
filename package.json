{
  "name": "kyc-lens-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "npm run setup -w kyc-lens-react",
    "build": "npm run build -w kyc-lens-react",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "npm run dev -w @kyc-lens/playground",
    "build:demo": "npm run build -w @kyc-lens/playground",
    "test:e2e": "npm run test:e2e -w @kyc-lens/playground --",
    "check:package": "npm run check:package -w kyc-lens-react",
    "check:size": "npm run check:size -w kyc-lens-react",
    "check:consumer": "npm run check:consumer -w kyc-lens-react",
    "check:matching-reference": "npm run check:matching-reference -w kyc-lens-react",
    "check:name": "npm run check:name -w kyc-lens-react",
    "deploy:cloudflare": "npm run build && npm run deploy -w @kyc-lens/gateway"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
